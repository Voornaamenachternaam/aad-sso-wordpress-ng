{
  "name": "voornaamenachternaamt/aad-sso-wordpress-ng",
  "description": "Single Sign-on with Microsoft Entra ID for WordPress",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.4.1",
    "psr/simple-cache": "^3.0.0",
    "firebase/php-jwt": "^7.0.5",
    "symfony/options-resolver": "^8.1.0",
    "monolog/monolog": "^3.10.0",
    "symfony/cache": "^8.1.1",
    "psr/http-client": "^1.0.3",
    "psr/http-factory": "^1.1.0",
    "symfony/http-client": "^8.1.1",
    "guzzlehttp/psr7": "^2.12.3",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2.3",
    "friendsofphp/php-cs-fixer": "^3.95.11",
    "szepeviktor/phpstan-wordpress": "^2.0.3",
    "phpunit/phpunit": "^13.2.2",
    "wp-coding-standards/wpcs": "^3.3.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
