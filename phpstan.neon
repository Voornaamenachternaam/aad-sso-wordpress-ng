includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    phpVersion: 80500
    paths:
        - aad-sso-wordpress.php
        - AuthorizationHelper.php
        - GraphHelper.php
        - Settings.php
        - SettingsPage.php
        - Logger.php
        - uninstall.php
        - view/
    excludePaths:
        - vendor/
        - tests/
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#^Function .+ not found#'
        - '#^Class .+ not found#'
        - '#^Method .+ not found#'
        - '#^Constant .+ not found#'
        - '#Parameter .+ of function .+ expects string, mixed given#'
        - '#Parameter .+ of function defined\(\) expects string, mixed given#'
        - '#Parameter .+ of method AADSSO_Settings_Page::sanitize_settings\(\) expects array, mixed given#'
        - '#Method AADSSO_Settings_Page::sanitize_settings\(\) has parameter \$input with no value type specified in iterable type array#'
        - '#Method AADSSO_Settings_Page::sanitize_settings\(\) return type has no value type specified in iterable type array#'
        - '#Method AADSSO_Settings_Page::get_editable_roles\(\) return type has no value type specified in iterable type array#'
        - '#Parameter .+ of method .+ expects string, string\|false given#'
        - '#Call to static method get_instance\(\) on an unknown class AADSSO_HttpClient#'
        - '#Static property AADSSO_AuthorizationHelper::\$http_client has invalid type AADSSO_HttpClient#'
        - '#Static property AADSSO_GraphHelper::\$http_client has invalid type AADSSO_HttpClient#'
        - '#Method AADSSO_GraphHelper::get_http_client\(\) should return AADSSO_HttpClient but returns mixed#'
        - '#Method AADSSO_AuthorizationHelper::get_http_client\(\) should return AADSSO_HttpClient but returns mixed#'
        - '#Method AADSSO_GraphHelper::get_required_headers_and_settings\(\) return type has no value type specified in iterable type array#'
        - '#Parameter #3 \$headers of static method Firebase\\JWT\\JWT::decode\(\) expects array<string>, list<string> given#'
