includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80505
    paths:
        - aad-sso-wordpress.php
        - AuthorizationHelper.php
        - GraphHelper.php
        - HttpClient.php
        - Settings.php
        - SettingsPage.php
        - Logger.php
        - uninstall.php
        - view/
    excludePaths:
        - vendor/
        - tests/
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Class alias errors - these classes are defined at runtime via class_alias()
        - '#Class .+AADSSO_Settings.+#'
        - '#Class .+AADSSO_Logger.+#'
        - '#Class .+AADSSO_AuthorizationHelper.+#'
        - '#Class .+AADSSO_GraphHelper.+#'
        - '#Class .+AADSSO_HttpClient.+#'
        - '#Class .+AADSSO.+#'
        # WordPress dynamic property access
        - '#Property WP_Roles::\$roles#'
        - '#Constant AADSSO_SETTINGS_PATH not found#'
