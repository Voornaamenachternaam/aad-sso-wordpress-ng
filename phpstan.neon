includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80505
    paths:
        - aad-sso-wordpress.php
        - AuthorizationHelper.php
        - GraphHelper.php
        - HttpClient.php
        - Settings.php
        - SettingsPage.php
        - Logger.php
        - uninstall.php
        - view/
    excludePaths:
        - vendor/
        - tests/
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Unknown class errors - class_alias() defines these at runtime
        - '#unknown class AADSSO_Settings#'
        - '#unknown class AADSSO_Logger#'
        - '#unknown class AADSSO_AuthorizationHelper#'
        - '#unknown class AADSSO_GraphHelper#'
        - '#unknown class AADSSO_HttpClient#'
        - '#invalid type AADSSO_Settings#'
        - '#invalid type AADSSO_Logger#'
        - '#invalid type AADSSO_AuthorizationHelper#'
        - '#invalid type AADSSO_GraphHelper#'
        - '#Instantiated class AADSSO_Settings_Page#'
        # WordPress dynamic property access
        - '#Property WP_Roles::\$roles#'
        - '#Constant AADSSO_SETTINGS_PATH not found#'
        # Mixed type operations - common with WordPress hooks/filter callbacks
        - '#Binary operation .+ between .+ and mixed#'
        - '#Parameter .+ expects .+, mixed given#'
        - '#Cannot call method .+ on mixed#'
        - '#Parameter .+ of function .+ expects string, mixed given#'
