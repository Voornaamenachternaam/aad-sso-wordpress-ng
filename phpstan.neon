includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: max
    paths:
        - aad-sso-wordpress.php
        - AuthorizationHelper.php
        - GraphHelper.php
        - Settings.php
        - SettingsPage.php
        - Logger.php
        - uninstall.php
        - view/
    excludePaths:
        - vendor/
        - tests/
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#^Function .+ not found#'
        - '#^Class .+ not found#'
        - '#^Method .+ not found#'
        - '#^Constant .+ not found#'